# dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# local data and run state (can contain API outputs; never commit)
data/
runs/*
!runs/published/

# local working notes: brief, plan, dev-run findings, API verification
# (docs/eval-gate.md is the one public page: the eval gate's reader docs)
docs/*
!docs/eval-gate.md
/manifest.json

# secrets and editor/OS files
.env
.env.*
.DS_Store
.vscode/
.idea/
.claude/
